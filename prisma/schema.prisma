datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ========================================================
// 1. User & Authentication Models (NextAuth + RBAC)
// ========================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String    @default("CUSTOMER") // "ADMIN" | "MARKETING" | "CUSTOMER"
  allowCredit   Boolean   @default(false)
  allowPickup   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  cart          Cart?
  orders        Order[]
  addresses     Address[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========================================================
// 2. Catalog Models (Categories & Products)
// ========================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  price          Int         // Price in USD cents (e.g. 1999 = .99). Eliminates floating-point inaccuracies.
  sku            String?     @unique
  inventory      Int         @default(0)
  images         String      @default("[]") // JSON stringified array of URLs or fallback image URL
  originDispatch String?     // Custom dispatch origin for the product
  categoryId     String?
  featured       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([featured])
}

// ========================================================
// 3. Shopping Cart Models (Guest -> Authenticated Persistence)
// ========================================================

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique // 1:1 with User for authenticated carts
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // Composite unique constraint prevents duplicate product rows in a cart
  @@index([cartId])
  @@index([productId])
}

// ========================================================
// 4. Address & Order Management Models (Checkout Scaffolding)
// ========================================================

model Address {
  id             String   @id @default(cuid())
  userId         String?
  fullName       String
  company        String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String   @default("US")
  phone          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingOrders Order[]  @relation("OrderShippingAddress")
  billingOrders  Order[]  @relation("OrderBillingAddress")

  @@index([userId])
  @@index([isDefault])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique // Human-friendly order identifier, e.g. "PIN-2026-1001"
  userId            String?
  customerEmail     String
  customerName      String
  customerPhone     String?
  status            String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus     String      @default("UNPAID")  // UNPAID, PAID, FAILED, REFUNDED
  paymentMethod     String      @default("INVOICE") // INVOICE, CREDIT_CARD, PO_NET30
  currency          String      @default("USD")
  subtotal          Int         // in USD cents
  tax               Int         @default(0) // in USD cents
  shipping          Int         @default(0) // in USD cents
  total             Int         // in USD cents
  shippingAddressId String?
  billingAddressId  String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress   Address?    @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    Address?    @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String   // Snapshot of product name at order time
  sku       String?  // Snapshot of SKU at order time
  price     Int      // Snapshot of unit price in cents at order time
  quantity  Int
  total     Int      // Snapshot of total in cents (price * quantity)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ========================================================
model FreightMethod {
  id          String   @id @default(cuid())
  name        String
  description String?
  cost        Int      // Cost in USD cents
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 5. Global Settings Model (Singleton Dynamic Configuration)
// ========================================================

model GlobalSetting {
  id                String   @id @default("singleton")
  companyName       String   @default("Pinnacle Distributing")
  contactEmail      String   @default("info@pinnacledistributing.com")
  contactPhone      String   @default("(800) 555-0199")
  address           String   @default("1234 Industrial Parkway, Suite 100, Dallas, TX 75201")
  hours             String   @default("Monday - Friday: 8:00 AM - 5:00 PM CST")
  mapEmbedUrl       String?
  smtpHost          String?
  smtpPort          Int      @default(587)
  smtpSecure        Boolean  @default(false)
  smtpUser          String?
  smtpPass          String?
  smtpFrom          String?
  smtpFromName      String?  @default("Pinnacle Distributing")
  notificationEmail    String?

  // Marketing Script Injection (R2)
  headScripts          String?
  bodyTopScripts       String?

  // Stripe Payment Gateway Configuration (R4 - DB Driven)
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  stripeEnabled        Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ========================================================
// 6. Contact Inquiries Model (Storefront Form Submissions)
// ========================================================

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("NEW") // NEW, READ, RESPONDED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
